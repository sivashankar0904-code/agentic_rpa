FROM python:3.12-slim

# uv: static binary, copied in rather than pip-installed — see the root
# Dockerfile's matching comment. Particularly helpful here: torch is a very
# large wheel, and uv's downloader has proven more reliable than pip's on it
# (pip hit a bare ReadTimeoutError partway through the torch download on a
# slow connection; uv retries/resumes instead of failing the whole install).
COPY --from=ghcr.io/astral-sh/uv:0.4.29 /uv /usr/local/bin/uv

# Training-worker image only — api/rpa-worker/beat/flower all build from the
# root Dockerfile (python:3.12-alpine) instead. Split because torch (see
# app/core/ml/, requirements-training.txt) publishes no musl-compatible
# wheel and no sdist either — Alpine has nothing to install it from at all.
# python:3.12-slim (Debian/glibc) is what torch's official CPU wheels
# target. No Chromium/Xvfb/x11vnc here: this worker only trains a model
# against images already sitting in MinIO — it never drives a browser.
WORKDIR /app

COPY requirements-training.txt .
# gcc/libjpeg-dev/zlib1g-dev: build-only, needed for pip to compile Pillow
# (and anything else without a prebuilt wheel for this platform) against
# libjpeg/zlib — purged again right after.
RUN apt-get update && apt-get install --no-install-recommends -y \
        gcc \
        libjpeg-dev \
        zlib1g-dev \
    && uv pip install --system --no-cache -r requirements-training.txt \
    && apt-get purge -y gcc libjpeg-dev zlib1g-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY app ./app

ENV PYTHONUNBUFFERED=1

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["training-worker"]
