FROM python:3.12-slim

# uv: static binary, copied in rather than pip-installed — see the root
# Dockerfile's and Dockerfile.training's matching comments.
COPY --from=ghcr.io/astral-sh/uv:0.4.29 /uv /usr/local/bin/uv

# Predict-worker image only — api/rpa-worker/beat/flower build from the root
# Dockerfile (python:3.12-alpine), training-worker from Dockerfile.training.
# A third image because inference is lightweight and interactive (called
# synchronously from an API request, see captcha_label_service.py) and
# shouldn't queue behind a 60-epoch training run on the same worker.
# python:3.12-slim (Debian/glibc) for the same reason as Dockerfile.training:
# torch has no musl-compatible wheel or sdist. No Chromium/Xvfb/x11vnc, no
# mlflow — this worker only loads a model and runs one forward pass.
WORKDIR /app

COPY requirements-predict.txt .
# gcc/libjpeg-dev/zlib1g-dev: build-only, needed for pip to compile Pillow
# against libjpeg/zlib — purged again right after.
RUN apt-get update && apt-get install --no-install-recommends -y \
        gcc \
        libjpeg-dev \
        zlib1g-dev \
    && uv pip install --system --no-cache -r requirements-predict.txt \
    && apt-get purge -y gcc libjpeg-dev zlib1g-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY app ./app

ENV PYTHONUNBUFFERED=1

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["predict-worker"]
