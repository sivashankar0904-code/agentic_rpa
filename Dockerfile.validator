FROM python:3.12-alpine

# uv: static binary, copied in rather than pip-installed — see the root
# Dockerfile's matching comment.
COPY --from=ghcr.io/astral-sh/uv:0.4.29 /uv /usr/local/bin/uv

# Validator-worker image only — api/rpa-worker/beat/flower build from the
# root Dockerfile, training-worker/predict-worker from their own
# torch-carrying Dockerfiles. This worker needs neither Chromium (never
# touches a browser) nor torch (calls the predict API over HTTP instead of
# running inference itself — see app/tasks/validator_tasks.py), so Alpine
# works fine here, unlike the torch-carrying images.
WORKDIR /app

COPY requirements-validator.txt .
# gcc/musl-dev: build-only, needed for psycopg[binary]'s C extension build
# on some platforms — purged again right after, same pattern as the root
# Dockerfile's .build-deps.
RUN apk add --no-cache --virtual .build-deps gcc musl-dev \
    && uv pip install --system --no-cache -r requirements-validator.txt \
    && apk del .build-deps

COPY app ./app

ENV PYTHONUNBUFFERED=1

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["validator-worker"]
